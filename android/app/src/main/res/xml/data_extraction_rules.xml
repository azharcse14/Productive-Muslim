<!-- Android 12+ counterpart of backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="bundled/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="bundled/" />
    </device-transfer>
</data-extraction-rules>
