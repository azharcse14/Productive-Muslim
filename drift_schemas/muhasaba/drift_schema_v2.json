    {
      "name": "tracker_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracker_items\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" INTEGER NOT NULL, \"daily_target\" INTEGER NULL, \"icon\" TEXT NOT NULL, \"color_index\" INTEGER NOT NULL, \"is_default\" INTEGER NOT NULL CHECK (\"is_default\" IN (0, 1)), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"created_on\" INTEGER NULL, \"archived_on\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "daily_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_entries\" (\"item_id\" TEXT NOT NULL REFERENCES tracker_items (id), \"date\" INTEGER NOT NULL, \"value\" INTEGER NOT NULL, PRIMARY KEY (\"item_id\", \"date\"));"
        }
      ]
    }
