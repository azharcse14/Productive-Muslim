{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ লক চালু থাকলে প্রোডাক্টিভ মুসলিম ফেস আইডি দিয়ে অ্যাপ আনলক করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Productive Muslim uses Face ID to unlock the app when app lock is on."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রোডাক্টিভ মুসলিম আপনার অবস্থান এই ডিভাইসেই নামাজের সময় ও কিবলার দিক হিসাবের জন্য ব্যবহার করে। আপনি নিজে ম্যাপে কাছের মসজিদ খুললে তবেই তা শেয়ার হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Productive Muslim uses your location on this device to calculate prayer times and the qibla direction. It is shared only if you choose to open nearby mosques in Maps."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রোডাক্টিভ মুসলিম কিবলা কম্পাস দেখাতে আপনার ফোনের মোশন সেন্সর ব্যবহার করে। মোশন ডেটা এই ডিভাইসেই থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Productive Muslim uses your phone's motion sensors to point the qibla compass. Motion data stays on this device."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি \"ছবি সংরক্ষণ\" বেছে নিলে প্রোডাক্টিভ মুসলিম শেয়ার করা ছবি, যেমন রমজানের অগ্রগতি কার্ড, আপনার ফটোতে সংরক্ষণ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Productive Muslim saves images you share, like your Ramadan progress card, to Photos when you choose Save Image."
          }
        }
      }
    }
  },
  "version": "1.0"
}
